# iMath runtime env. NAMES ONLY here: copy this file to %USERPROFILE%\.ssh\imath.env and fill the values
# from the PRODUCTION sources listed below (NOT from .env.local, which points at the dev Convex deployment).
# Format: NAME=value (no spaces around "=", no quotes needed). Never commit the filled-in file.
# step5-env.sh validates it (prints names only), installs it and deletes the upload.

# --- required ---
# Convex dashboard -> Production deployment -> Settings -> URL & Deploy Key -> Deployment URL (https://<name>.convex.cloud).
# Read at runtime by the API routes and the Convex Auth middleware, so it is here AND a GitHub Variable.
NEXT_PUBLIC_CONVEX_URL=
# Convex dashboard -> Production deployment -> Settings -> Environment Variables -> CONVEX_SERVER_SECRET (copy, don't change).
CONVEX_SERVER_SECRET=
# Telegram @BotFather -> /mybots -> <your bot> -> API Token (do NOT press "Revoke current token").
TELEGRAM_BOT_TOKEN=
# The chat the alerts go to today, e.g. web.telegram.org/a/ -> open the group -> the number after "#" in the URL (-100...).
TELEGRAM_CHAT_ID=

# Build-time only (GitHub Variables), NOT here: NEXT_PUBLIC_SITE_URL.
# Not read by the Next.js app (Convex-side or unused), NOT here: CONVEX_DEPLOY_KEY, CONVEX_DEPLOYMENT, CONVEX_SITE_URL,
# NEXT_PUBLIC_CONVEX_SITE_URL, ADMIN_EMAIL_ALLOWLIST, JWT_PRIVATE_KEY, JWKS, DEFAULT_COUNTRY_CODE, DEFAULT_CURRENCY.
